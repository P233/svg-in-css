{
  "name": "svg-in-css",
  "version": "2.1.0",
  "description": "",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "serve": "vite preview",
    "prepare": "husky",
    "lint": "eslint src tests *.config.* --max-warnings 0 && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint src tests *.config.* --fix --max-warnings 0 && stylelint \"src/**/*.scss\" --fix",
    "format": "prettier --write src tests *.config.*",
    "format:check": "prettier --check src tests *.config.* package.json tsconfig.json types.d.ts pnpm-workspace.yaml .stylelintrc.json",
    "test": "pnpm build && playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@p233/stylelint-config-scss": "^4.1.0",
    "@playwright/test": "^1.64.0",
    "@types/prismjs": "^1.26.6",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "stylelint": "^16.26.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "color": "^5.0.3",
    "prismjs": "^1.30.0",
    "solid-js": "^1.9.17",
    "solid-toast": "^0.5.0",
    "svgo": "^4.1.0"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.scss": [
      "stylelint --fix",
      "prettier --write"
    ],
    "!(package*).json": [
      "prettier --write"
    ]
  }
}
